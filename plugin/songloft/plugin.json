{
  "name": "多源音乐桥",
  "version": "1.4.52",
  "description": "多源音乐桥：把飞牛音乐、WebDAV、Subsonic/Navidrome 统一接入 SongLoft，提供统一浏览、搜索、播放、收藏、批量入库，支持抖音方式切割、逐字歌词/桌面歌词、智能音箱投放等。",
  "author": "pcyear",
  "authorUrl": "https://www.035151.xyz/?ref=4",
  "license": "MIT",
  "homepage": "https://gitee.com/pcyear/pcyear-bridge-release",
  "updateUrl": "https://gitee.com/pcyear/pcyear-bridge-release/raw/master/manifest.json",
  "entryPath": "multisource-music",
  "main": "main.js",
  "icon": "icon.png",
  "minHostVersion": "2.11.0",
  "permissions": [
    "storage",
    "songs.read",
    "songs.write",
    "playlists.read",
    "playlists.write",
    "fs:music",
    "fs",
    "inter-plugin"
  ],
  "publicPaths": [
    "/cover-img",
    "/cover-data",
    "/cover-search",
    "/lyric-search",
    "/debug-art",
    "/api",
    "/rest"
  ],
  "entryHash": "",
  "zipHash": ""
